{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@app/domain": ["packages/domain/src/index.ts"],
      "@app/geo": ["packages/geo/src/index.ts"],
      "@app/solver": ["packages/solver/src/index.ts"],
      "@app/storage": ["packages/storage/src/index.ts"]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "sourceMap": true,
    "composite": true,
    "declarationMap": true
  }
}
